# Gildin koma úr `npx supabase start` (API URL og anon key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile (CAPTCHA). Tómt = engin CAPTCHA (þróun).
# Leynilykillinn fer í Supabase: Authentication → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Web Push (VAPID). Búa til nýtt par: sjá README. Einkalykillinn (JWK sem JSON á einni línu)
# fer líka á Cloudflare: npx wrangler secret put VAPID_PRIVATE_JWK
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
