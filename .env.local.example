# Gildin koma úr `npx supabase start` (API URL og anon key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile (CAPTCHA). Tómt = engin CAPTCHA (þróun).
# Leynilykillinn fer í Supabase: Authentication → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
